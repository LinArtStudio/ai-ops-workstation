# 智谱AI API (必填，仅服务端使用，勿加 NEXT_PUBLIC_ 前缀)
# 免费注册：https://open.bigmodel.cn
ZHIPUAI_API_KEY=your_zhipuai_api_key

# Supabase (M0 起必填：Auth + 数据持久化)
# 免费注册：https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# 可选：仅本地维护脚本使用，应用运行时不再依赖 HTTP migrate
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 自动执行 SQL 迁移（推荐，比 DATABASE_URL 更好找）：
# Dashboard 右上角头像 → Account → Access Tokens → Generate
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx
# SUPABASE_PROJECT_REF=vzcbwzislmenrlnugmih

# 备选：Postgres URI（Dashboard → Project Settings → Database → Connection string）
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-xx.pooler.supabase.com:5432/postgres

# 阶段 A 双账号隔离自检（npm run verify:stage-a）
# STAGE_A_USER_A_EMAIL=
# STAGE_A_USER_A_PASSWORD=
# STAGE_A_USER_B_EMAIL=
# STAGE_A_USER_B_PASSWORD=

# 可选：无 project_plans 行时，用环境变量手动升档（逗号分隔项目 UUID）
# PRO_PROJECT_IDS=
# TEAM_PROJECT_IDS=
# 兼容旧名（等同 Team）
# AGENCY_PROJECT_IDS=

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000
